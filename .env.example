# ════════════════════════════════════════════════════════════
# OtherMe — Variables d'environnement
# Copier ce fichier en .env et remplir toutes les valeurs.
# Ne jamais committer le fichier .env dans git.
# ════════════════════════════════════════════════════════════


# ── Frontend public (préfixe VITE_ obligatoire) ──────────────
# Ces variables sont intégrées dans le bundle JavaScript côté client.
# Ne jamais y mettre de clés secrètes.

# Supabase — URL publique du projet
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase — clé anon (publique, protégée par les RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Stripe — clé publiable (safe côté client)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# URL de l'application (ex: https://otherme.replit.app en production)
VITE_APP_URL=http://localhost:5173

# Microsoft Clarity — laisser vide pour désactiver le tracking
VITE_CLARITY_PROJECT_ID=

# Google Analytics 4 — laisser vide pour désactiver le tracking
VITE_GA_MEASUREMENT_ID=


# ── Backend secret (sans préfixe VITE_) ─────────────────────
# Ces variables ne sont accessibles que côté serveur Node.js.
# Vite ne les expose JAMAIS dans le bundle client.

# Supabase — service_role key (accès complet, à ne jamais exposer)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# OpenAI — clé API pour la génération des trajectoires (gpt-4o)
OPENAI_API_KEY=sk-...

# Stripe — clé secrète pour créer les sessions et valider les webhooks
STRIPE_SECRET_KEY=sk_test_...

# Stripe — secret de signature des webhooks (obtenu via `stripe listen` en dev)
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — clé API pour l'envoi d'emails
RESEND_API_KEY=re_...

# Adresse d'expédition des emails (domaine vérifié dans Resend)
FROM_EMAIL=OtherMe <noreply@tondomaine.com>


# ── Serveur ──────────────────────────────────────────────────

# Port du serveur Express (défaut: 3001)
PORT=3001
