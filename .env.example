# ════════════════════════════════════════════════════════════
# OtherMe — Variables d'environnement
# Copier ce fichier en .env et remplir toutes les valeurs.
# Ne jamais committer le fichier .env dans git.
# ════════════════════════════════════════════════════════════


# ── Frontend public (préfixe VITE_ obligatoire) ──────────────
# Ces variables sont intégrées dans le bundle JavaScript côté client.
# Ne jamais y mettre de clés secrètes.

# Supabase → Dashboard → Settings → API → Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase → Dashboard → Settings → API → anon / public
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Stripe → dashboard.stripe.com → Developers → API Keys → Publishable key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# URL de l'application (http://localhost:5173 en dev, URL publique en prod)
# Utilisée dans les success_url / cancel_url renvoyés à Stripe
VITE_APP_URL=http://localhost:5173

# Microsoft Clarity — laisser vide pour désactiver
VITE_CLARITY_PROJECT_ID=

# Google Analytics 4 — laisser vide pour désactiver
VITE_GA_MEASUREMENT_ID=

# Rapports de démonstration (mock_*)
# true  → autorisé  (dev local uniquement)
# false → bloqué    (production — ne jamais passer à true sur Vercel)
# Si absent en production, les mocks sont bloqués automatiquement (safe par défaut).
VITE_ALLOW_MOCK_REPORTS=false


# ── Backend secret (sans préfixe VITE_) ─────────────────────
# Ces variables ne sont jamais exposées dans le bundle client.

# Supabase → Dashboard → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# OpenAI → platform.openai.com → API Keys
OPENAI_API_KEY=sk-...

# Stripe → dashboard.stripe.com → Developers → API Keys → Secret key
STRIPE_SECRET_KEY=sk_test_...

# Stripe → obtenu via : stripe listen --forward-to localhost:3001/api/stripe/webhook
# En production : Dashboard → Developers → Webhooks → Add endpoint
#   URL : https://VOTRE_DOMAINE.vercel.app/api/stripe/webhook
#   Événements : checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe → Dashboard → Products → sélectionner le produit → copier l'ID du prix
# Si défini : utilisé pour la session Checkout (recommandé en production).
# Si absent : prix créé dynamiquement à 14,99 € — acceptable en développement.
STRIPE_PRICE_ID=price_...

# Resend → resend.com → API Keys
RESEND_API_KEY=re_...

# Adresse d'expédition (domaine vérifié dans Resend)
FROM_EMAIL=OtherMe <noreply@tondomaine.com>


# ── Serveur ──────────────────────────────────────────────────

# Port du serveur Express (Vite tourne sur 5000, Express sur 3001)
PORT=3001
